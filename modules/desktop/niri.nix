{
  delib,
  lib,
  pkgs,
  ...
}:
let
  # Writes the live output layout (e.g. after arranging in wdisplays) to a file
  # outside the repo that config/niri/config.kdl includes, so it survives logout.
  niri-save-outputs = pkgs.writeShellApplication {
    name = "niri-save-outputs";
    runtimeInputs = with pkgs; [
      niri
      jq
      coreutils
    ];
    text = ''
      out="''${1:-''${XDG_CONFIG_HOME:-$HOME/.config}/niri-outputs.kdl}"
      json=$(niri msg --json outputs)
      tmp=$(mktemp "$out.XXXXXX")
      trap 'rm -f "$tmp"' EXIT

      {
        echo "// Generated by niri-save-outputs on $(date -Iseconds). Re-run it after changing outputs."
        jq -r '
          def transform: {
            "Normal": "normal", "_90": "90", "_180": "180", "_270": "270",
            "Flipped": "flipped", "Flipped90": "flipped-90",
            "Flipped180": "flipped-180", "Flipped270": "flipped-270"
          }[.] // "normal";
          def refresh: "\(. / 1000 | floor).\("00\(. % 1000)" | .[-3:])";
          to_entries | sort_by(.value.logical.x // 0) | .[].value
          | (if .make and .model and .serial then "\(.make) \(.model) \(.serial)" else .name end) as $id
          | if .logical == null then
              "output \($id | tojson) {\n    off\n}\n"
            else
              (.modes[.current_mode]) as $m
              | "output \($id | tojson) {\n"
                + "    mode \(if .is_custom_mode then "custom=true " else "" end)\"\($m.width)x\($m.height)@\($m.refresh_rate | refresh)\"\n"
                + "    scale \(.logical.scale)\n"
                + "    transform \"\(.logical.transform | transform)\"\n"
                + "    position x=\(.logical.x) y=\(.logical.y)\n"
                + (if .vrr_enabled then "    variable-refresh-rate\n" else "" end)
                + "}\n"
            end
        ' <<<"$json"
      } >"$tmp"

      mv "$tmp" "$out"
      trap - EXIT
      echo "Saved output layout to $out"
    '';
  };
in
delib.module {
  name = "desktop.niri";

  options = delib.singleEnableOption false;

  myconfig.always = { myconfig, ... }: {
    desktop.niri.enable = lib.mkDefault (myconfig.desktop.enable or false);
  };

  home.ifEnabled = { myconfig, ... }: {
    home.file.".config/niri".source =
      pkgs.runCommandLocal "niri-config-symlink" { }
        "ln -s /home/${myconfig.constants.username}/nix-config/config/niri $out";

    home.packages = with pkgs; [
      niri
      kanshi
      wdisplays
      niri-save-outputs
      xwayland-satellite # niri auto-spawns it for X11 apps (also needed by vmware-user clipboard sync)
    ];

    systemd.user.services.niri = {
      Unit = {
        Description = "Niri Wayland compositor";
        BindsTo = [ "graphical-session.target" ];
        Before = [ "graphical-session.target" ];
        Wants = [
          "graphical-session-pre.target"
          "xdg-desktop-autostart.target"
        ];
        After = [ "graphical-session-pre.target" ];
      };
      Service = {
        Slice = "session.slice";
        Type = "notify";
        ExecStart = "${pkgs.niri}/bin/niri --session";
      };
    };

    systemd.user.targets."niri-shutdown" = {
      Unit = {
        Description = "Shutdown running niri session";
        DefaultDependencies = false;
        StopWhenUnneeded = true;
        Conflicts = [
          "graphical-session.target"
          "graphical-session-pre.target"
        ];
        After = [
          "graphical-session.target"
          "graphical-session-pre.target"
        ];
      };
    };
  };
}
